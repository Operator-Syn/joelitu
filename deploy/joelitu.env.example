# Copy to deploy/joelitu.env and fill in. That file is gitignored; this one is not.

# Required. Bot token from the Discord developer portal.
DISCORD_TOKEN=replace-me

# Optional. When set, slash commands register against this guild and appear
# immediately. Leave empty in production to register globally (up to an hour of
# propagation delay).
TEST_GUILD_ID=

# Optional. `info` is the default the binary falls back to.
RUST_LOG=info
